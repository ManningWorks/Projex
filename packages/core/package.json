{
  "name": "@manningworks/projex",
  "version": "1.6.0",
  "description": "Show Everything You Ship",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "projex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./themes/theme-minimal.css": "./dist/themes/theme-minimal.css",
    "./themes/theme-dark.css": "./dist/themes/theme-dark.css",
    "./themes/theme-gradient.css": "./dist/themes/theme-gradient.css"
  },
  "scripts": {
    "build": "tsc && node copy-components.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:components": "vitest run --config vitest.config.ts src/components",
    "benchmark": "vitest bench --config vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManningWorks/Projex.git"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@inquirer/confirm": "^6.3.2",
    "@inquirer/input": "^5.1.6",
    "@inquirer/number": "^4.2.3",
    "@inquirer/search": "^4.3.3",
    "@inquirer/select": "^5.2.5",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ts-morph": "^28.0.0"
  },
  "peerDependenciesMeta": {
    "@inquirer/confirm": {
      "optional": true
    },
    "@inquirer/input": {
      "optional": true
    },
    "@inquirer/number": {
      "optional": true
    },
    "@inquirer/search": {
      "optional": true
    },
    "@inquirer/select": {
      "optional": true
    },
    "chalk": {
      "optional": true
    },
    "commander": {
      "optional": true
    },
    "ts-morph": {
      "optional": true
    }
  }
}
